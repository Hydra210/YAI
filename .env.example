# Required by the bot
DISCORD_TOKEN=
GROQ_API_KEY=
DATABASE_URL=

# Optional: Tavily web search (recommended primary provider).
# Create a key at https://www.tavily.com/ and add it to Render's environment.
TAVILY_API_KEY=

# Optional fallback search providers.
SERPER_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=

# Optional: needed for the Discord-login dashboard.
# Register this exact callback URI in your Discord application's OAuth2 settings.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:10000/dashboard/callback
